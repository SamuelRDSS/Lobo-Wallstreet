    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const first = $input.first().json;\nconst body = first.body ?? first;\nconst value = body.entry?.[0]?.changes?.[0]?.value ?? body;\nconst msg = value.messages?.[0] ?? body.messageObject ?? body;\nconst contact = value.contacts?.[0] ?? {};\n\nconst message = body.message || msg.text?.body || msg.button?.text || msg.interactive?.button_reply?.title || '';\nconst phone = body.phone || body.from || msg.from || contact.wa_id || '';\nconst contactName = body.contactName || contact.profile?.name || body.name || '';\n\nreturn [{\n  json: {\n    leadId: body.leadId || null,\n    phone,\n    contactName,\n    message,\n    token: $env.LOBO_WHATSAPP_INBOUND_TOKEN || body.token || '',\n    providerPayload: body\n  }\n}];"
      },
      "id": "lobo-whatsapp-inbound-normalize",
      "name": "Normalizar resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        0
      ]
    },
